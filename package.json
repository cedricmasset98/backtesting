{
  "name": "swiss-equity-portfolio-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Swiss Equity Portfolio Lab — walk-forward backtests of eight portfolio strategies on Swiss equities",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "data": "python -m pipeline.build && python -m pipeline.statsref",
    "data:quick": "python -m pipeline.build --quick && python -m pipeline.statsref"
  },
  "dependencies": {
    "plotly.js-dist-min": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
